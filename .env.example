# Copy to .env and fill in. Every variable below is declared in src/env.ts
# (public: true = importable from $app/env/public, otherwise $app/env/private).

# Test Database Configuration
# Sqlite Database URL
TEST_DATABASE_URL=file:test.db

# Encryption key for password hashing, DO NOT LOSE THIS
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-encryption-key-here

# OAuth Configuration
# GitHub OAuth (if using GitHub authentication)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Email Configuration
PLUNK_BASE_URL="https://next-api.useplunk.com"
PLUNK_SECRET_KEY=your-plunk-secret-key
# Base URL used in verification/reset links (falls back to request origin)
BASE_URL=http://localhost:5173

# Auth timeouts (all optional; code defaults apply when unset)
EMAIL_VERIFICATION_TIMEOUT_MINUTES=1
PASSWORD_RESET_TIMEOUT_MINUTES=1
RESEND_COOLDOWN_SECONDS=60

# Cloudflare Turnstile (bot protection on auth forms)
TURNSTILE_SECRET=your-turnstile-secret
# Public site key lives in wrangler.toml [vars] (read via `cloudflare:workers`
# `env`, emulated in `vite dev`). Widget domains must include localhost +
# 127.0.0.1 for local dev, or use Cloudflare's test keys (any hostname):
#   site key: 1x0000000000000000000000000000000AA (as a wrangler [vars] override)
#   secret:   1x0000000000000000000000000000000AA (as TURNSTILE_SECRET above)
