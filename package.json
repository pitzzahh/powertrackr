{
  "name": "powertrackr",
  "version": "2.5.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "build:preview": "pnpm run build && pnpm run preview",
    "prepare": "svelte-kit sync || echo ''",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || echo 'Git hooks setup skipped'",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && wrangler d1 migrations apply powertrackr-db",
    "db:migrate:local": "wrangler d1 migrations apply powertrackr-db --local",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@noble/hashes": "^2.4.0",
    "@oslojs/encoding": "^1.1.0",
    "@pilcrowjs/object-parser": "^0.0.4",
    "@tanstack/store": "^0.11.2",
    "@tanstack/table-core": "^9.3.1",
    "@tanstack/virtual-core": "^3.19.9",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "1.0.0-rc.4",
    "mode-watcher": "^1.1.0",
    "otpauth": "^9.5.2",
    "runed": "^0.38.0",
    "svelte-toolbelt": "^0.10.6",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@libsql/client": "^0.18.0",
    "@lucide/svelte": "^1.66.0",
    "@number-flow/svelte": "^0.4.2",
    "@prettier/plugin-oxc": "^0.2.3",
    "@svelte-put/qr": "^2.1.3",
    "@sveltejs/adapter-cloudflare": "8.0.2",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-table": "^9.3.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "bits-ui": "^2.20.3",
    "clsx": "^2.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^30.1.3",
    "layerchart": "^2.9.2",
    "oxlint": "^1.90.0",
    "phosphor-svelte": "^3.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sv-agentation": "^0.4.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-render-scan": "^1.1.0",
    "svelte-seo": "^2.0.0",
    "svelte-sonner": "^1.2.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  }
}
