{
  "name": "powertrackr",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "build:preview": "pnpm run build && pnpm run preview",
    "prepare": "svelte-kit sync || echo ''",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || echo 'Git hooks setup skipped'",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && wrangler d1 migrations apply powertrackr-db",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "@noble/hashes": "^2.3.0",
    "@oslojs/encoding": "^1.1.0",
    "@pilcrowjs/object-parser": "^0.0.4",
    "@tanstack/table-core": "^9.1.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "1.0.0-rc.4",
    "mode-watcher": "^1.1.0",
    "otpauth": "^9.5.1",
    "runed": "^0.37.1",
    "svelte-toolbelt": "^0.10.6",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@lucide/svelte": "^1.31.0",
    "@number-flow/svelte": "^0.4.2",
    "@prettier/plugin-oxc": "^0.2.2",
    "@svelte-put/qr": "^2.1.3",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-table": "^9.1.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^30.0.1",
    "layerchart": "^2.1.1",
    "oxlint": "^1.78.0",
    "phosphor-svelte": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sv-agentation": "^0.4.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "svelte-render-scan": "^1.1.0",
    "svelte-seo": "^2.0.0",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  }
}
