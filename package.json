{
  "name": "powertrackr",
  "version": "2.5.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev --port 4173",
    "build:preview": "pnpm run build && pnpm run preview",
    "prepare": "svelte-kit sync || echo ''",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || echo 'Git hooks setup skipped'",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && wrangler d1 migrations apply powertrackr-db",
    "db:migrate:local": "wrangler d1 migrations apply powertrackr-db --local",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@noble/hashes": "^2.4.0",
    "@oslojs/encoding": "^1.1.0",
    "@pilcrowjs/object-parser": "^0.0.4",
    "@tanstack/store": "^0.11.2",
    "@tanstack/table-core": "^9.3.1",
    "@tanstack/virtual-core": "^3.19.11",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "drizzle-orm": "1.0.0-rc.4",
    "mode-watcher": "^1.1.0",
    "otpauth": "^9.6.0",
    "runed": "^0.38.0",
    "svelte-toolbelt": "^0.13.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261120.1",
    "@libsql/client": "^0.18.0",
    "@lucide/svelte": "^1.76.0",
    "@number-flow/svelte": "^0.4.2",
    "@prettier/plugin-oxc": "^0.2.4",
    "@svelte-put/qr": "^2.1.3",
    "@sveltejs/adapter-cloudflare": "9.0.0",
    "@sveltejs/enhanced-img": "^1.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/svelte-table": "^9.3.2",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^31.0.1",
    "layerchart": "^2.11.0",
    "oxlint": "^1.94.0",
    "phosphor-svelte": "^3.1.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sv-agentation": "^0.4.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "svelte-render-scan": "^1.1.0",
    "svelte-seo": "^2.0.0",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  }
}
